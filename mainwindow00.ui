  <property name="styleSheet">
   <string notr="true">/* =================================
 * 全局设置: 科技感深色基调
 * ================================= */
* {
    /* 统一使用清晰的无衬线字体 */
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 10pt; 
    
    /* 核心配色 */
    color: #E0E0E0; /* 默认文字颜色 (亮灰色) */
    background-color: #1A1A2E; /* 科技感深蓝黑基底 */
    
    /* 强调色：科技蓝 */
    selection-background-color: #00ADB5; 
    selection-color: #FFFFFF;
}

/* 主窗口和中央控件背景 - 最深的区域 */
QMainWindow, QWidget#centralwidget {
    background-color: #0F0F23; /* 比其他控件更深的背景，增强层次感 */
}

/* 通用控件背景（按钮、输入框、容器内嵌控件） */
QPushButton, QLineEdit, QSpinBox, QGroupBox {
    background-color: #232946; /* 深蓝灰色 */
    border: 1px solid #3A3F70; /* 柔和的深蓝色边框 */
    border-radius: 4px;
    color: #E0E0E0;
}


/* =================================
 * 控件细节: 按钮、输入框、选择框
 * ================================= */

QPushButton {
    padding: 6px;
    min-height: 28px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #2F3658;
    border: 1px solid #00ADB5;
}
QPushButton:pressed {
    background-color: #00ADB5;
    color: #0F0F23;
}
QPushButton:disabled {
    background-color: #1A1A2E;
    border: 1px dashed #3A3F70;
    color: #555577;
}

QLineEdit, QSpinBox {
    background-color: #1A1A2E;
    padding: 4px;
    border: 1px solid #3A3F70;
}
QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #00ADB5;
    background-color: #1A1A2E;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}
QCheckBox::indicator {
    border: 1px solid #3A3F70;
    border-radius: 3px;
    background-color: #232946;
}
QCheckBox::indicator:checked {
    background-color: #00ADB5;
}


/* =================================
 * 容器类: GroupBox, ToolBox, Dock
 * ================================= */

QGroupBox {
    border: 1px solid #3A3F70;
    border-radius: 4px;
    margin-top: 1ex; 
    padding-top: 5px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
    background-color: transparent;
    color: #00ADB5;
    font-weight: bold;
}

/* =================================
 * QToolBox Tab - 最终排查修正
 * * 确保所有样式属性都写在 QToolBoxButton 的相应状态下。
 * ================================= */
QToolBox {
    background-color: transparent;
}

/* --- 未选中 Tab 默认样式 (深灰色) --- */
QToolBoxButton {
    /* 统一设置高度和间距，确保渲染为一个独立块 */
    min-height: 36px; /* 略微增大高度 */
    padding: 6px 15px; 
    margin-top: 4px;    
    margin-bottom: 2px; 
    text-align: left;
    
    /* 背景和边框 */
    background-color: #2F3136; /* 图片中 DataTransfer/View 的深灰色背景 */
    border: 1px solid #40444B; /* 清晰的深色边框 */
    border-radius: 4px; 
    
    /* 文本样式 */
    color: #E0E0E0; 
    font-weight: normal;
}

/* 未选中 Tab 的悬停效果 */
QToolBoxButton:hover {
    background-color: #40444B; /* 悬停时略微变深 */
    border: 1px solid #72767D; /* 悬停时边框略微变亮 */
}

/* --- 选中 Tab 样式 (亮紫色高亮) --- */
QToolBoxButton:checked {
    /* 统一设置高度和间距，确保渲染为一个独立块 */
    min-height: 36px; 
    padding: 6px 15px; 
    margin-top: 4px;    
    margin-bottom: 2px; 
    text-align: left;
    
    /* 强制应用亮紫色背景 */
    background-color: #5865F2; 
    
    /* 强制应用白色文本 */
    color: #FFFFFF; 
    font-weight: bold; 
    
    /* 亮色边框 */
    border: 1px solid #FFFFFF; 
    border-radius: 4px;
}

/* 确保 QToolBox::tab 仍然是透明的 */
QToolBox::tab {
    background: transparent; 
    border: none;
    min-height: 0px; 
    padding: 0;
    margin: 0;
    color: #E0E0E0; 
}

/* --- DOCK WIDGET 和 TAB BAR 修正 --- */
QDockWidget {
    border: 1px solid #3A3F70;
}
QDockWidget::title {
    background: #1A1A2E;
    padding: 4px;
    border-bottom: 1px solid #3A3F70;
    color: #00ADB5;
}

/* 解决 Dock Tab 背景白色的问题 */
QTabBar {
    background-color: #1A1A2E; /* 确保 Tab Bar 容器是深色 */
}
QTabBar::tab {
    background-color: #232946;
    color: #E0E0E0;
    border: 1px solid #3A3F70;
    border-bottom: none;
    padding: 5px 12px;
    min-width: 80px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: #00ADB5; 
    color: #0F0F23;
    font-weight: bold;
    border-color: #00ADB5;
}
QTabBar::tab:!selected:hover {
    background-color: #2F3658; 
}
QStackedWidget {
    background-color: #232946;
}
/* --- END DOCK WIDGET TAB BAR 修正 --- */


/* 确保 DockContents 和 Label 背景是深色 */
QWidget#videoDockContents, 
QWidget#rdDockContents,
QWidget#logDockContents,
QWidget#dockWidgetContents_2 {
    background-color: #232946;
}
QLabel#videoLabel {
    background-color: #232946;
    color: #E0E0E0;
    border: none;
}
QLabel {
    color: #B0B0E0;
}

/* Log 窗口 */
QTextEdit#logTextEdit {
    background-color: #1A1A2E;
    border: 1px solid #3A3F70;
    padding: 5px;
    color: #E0E0E0;
}

/* =================================
 * 其他: MenuBar, ScrollBar, StatusBar
 * ================================= */

QMenuBar {
    background-color: #1A1A2E;
    border-bottom: 1px solid #3A3F70;
}
QMenuBar::item:selected {
    background: #00ADB5;
    color: #0F0F23;
}

QStatusBar {
    background-color: #1A1A2E;
    border-top: 1px solid #3A3F70;
    color: #B0B0E0;
}

QScrollBar:vertical, QScrollBar:horizontal {
    border: none;
    background: #1A1A2E;
    width: 10px;
    height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #3A3F70;
    border-radius: 5px;
    min-height: 20px;
    min-width: 20px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #00ADB5;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    border: none;
    background: none;
}</string>
